{
  "_comment": "Flux dev + ControlNet Union (режим openpose). Скелет позы подставляется в LoadImage.",
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "{{UNET}}", "weight_dtype": "default"}},
  "2": {"class_type": "DualCLIPLoader", "inputs": {"clip_name1": "{{CLIP_T5}}", "clip_name2": "{{CLIP_L}}", "type": "flux"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "{{VAE}}"}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{POSITIVE}}", "clip": ["2", 0]}},
  "5": {"class_type": "FluxGuidance", "inputs": {"guidance": "{{GUIDANCE}}", "conditioning": ["4", 0]}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["2", 0]}},
  "7": {"class_type": "EmptySD3LatentImage", "inputs": {"width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1}},
  "11": {"class_type": "LoadImage", "inputs": {"image": "{{POSE_IMAGE}}"}},
  "12": {"class_type": "ControlNetLoader", "inputs": {"control_net_name": "{{CONTROLNET}}"}},
  "13": {"class_type": "SetUnionControlNetType", "inputs": {"type": "openpose", "control_net": ["12", 0]}},
  "14": {"class_type": "ControlNetApplyAdvanced", "inputs": {"strength": 0.75, "start_percent": 0.0, "end_percent": 0.6,
         "positive": ["5", 0], "negative": ["6", 0], "control_net": ["13", 0], "image": ["11", 0], "vae": ["3", 0]}},
  "8": {"class_type": "KSampler", "inputs": {"seed": "{{SEED}}", "steps": "{{STEPS}}", "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0,
        "model": ["1", 0], "positive": ["14", 0], "negative": ["14", 1], "latent_image": ["7", 0]}},
  "9": {"class_type": "VAEDecode", "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
  "10": {"class_type": "SaveImage", "inputs": {"filename_prefix": "{{PREFIX}}", "images": ["9", 0]}}
}
